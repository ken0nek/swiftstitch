require "json"

package = JSON.parse(File.read(File.join(__dir__, "package.json")))

Pod::Spec.new do |s|
  s.name         = "NitroCounter"
  s.version      = package["version"]
  s.summary      = package["description"]
  s.homepage     = "https://github.com/ken0nek/swiftstitch"
  s.license      = "MIT"
  s.authors      = "SwiftStitch"

  s.platforms    = { :ios => min_ios_version_supported }
  s.source       = { :git => ".", :tag => "#{s.version}" }

  # User-authored Hybrid impl(s).
  s.source_files = "swift/**/*.swift"

  # Pull in the nitrogen-generated bridge files (C++ specs, Swift bridges,
  # autolinking glue). Regenerated by `./codegen.sh`.
  load File.join(__dir__, "nitrogen", "generated", "ios", "NitroCounter+autolinking.rb")
  add_nitrogen_files(s)

  s.requires_arc = true

  # Wire up React Native module dependencies (NitroModules, RN core, etc.).
  install_modules_dependencies(s)
end
